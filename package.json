{
  "name": "wow-games",
  "version": "1.0.0",
  "private": true,
  "description": "WOW GAMES — THE INFINITE ARCADE. A futuristic browser arcade with original games.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@14 out -l tcp://0.0.0.0:3000",
    "typecheck": "tsc --noEmit",
    "verify:content": "tsx scripts/verify-content.ts",
    "verify:games": "tsx scripts/simulate-geometry.ts && tsx scripts/simulate-flappy.ts",
    "verify": "tsc --noEmit && tsx scripts/verify-content.ts && tsx scripts/simulate-geometry.ts && tsx scripts/simulate-flappy.ts && tsx scripts/verify-export.ts",
    "verify:export": "tsx scripts/verify-export.ts"
  },
  "dependencies": {
    "@fontsource/orbitron": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "next": "15.5.29",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  }
}
